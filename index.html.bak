                                <li><strong>減碼訊號</strong>：一旦跌破昨日低點，立即判定短線轉弱。</li>
                                <li><strong>砍半規則</strong>：<strong>加碼倉（折溢部位）立刻賣出一半 (50%)</strong>！</li>
                                <li><strong>實現獲利入帳</strong>：抽回本金與利潤，自動累計至「停泊資金」，等待下次過高加碼！</li>
                            </ul>
                        </div>
                    </div>
                `;
            }
        }

        // 載入資料
        function loadPortfolioFromStorageOrUrl() {
            try {
                const hash = window.location.hash;
                if (hash && hash.startsWith('#data=')) {
                    const encoded = hash.substring(6);
                    const decoded = decodeURIComponent(atob(encoded));
                    const payload = JSON.parse(decoded);
                    if (payload.stocks && Array.isArray(payload.stocks)) {
                        stockList = payload.stocks;
                        totalCapital = payload.totalCapital || totalCapital;
                        usdExchangeRate = payload.usdRate || usdExchangeRate;
                        saveToStorage();
                        return;
                    } else if (Array.isArray(payload)) {
                        stockList = payload;
                        saveToStorage();
                        return;
                    }
                }
            } catch (e) {
                console.warn("URL Hash 解碼異常:", e);
            }

            // 版本檢查：若為舊版本快取，自動重設為 150 萬資產配置最新真實戰報
            const storedVersion = localStorage.getItem('tina_portfolio_version');
            if (storedVersion !== CURRENT_PORTFOLIO_VERSION) {
                stockList = JSON.parse(JSON.stringify(DEFAULT_STOCKS));
                totalCapital = 1500000;
                usdExchangeRate = 32.5;
                localStorage.setItem('tina_portfolio_version', CURRENT_PORTFOLIO_VERSION);
                saveToStorage();
                return;
            }

            const storedCap = localStorage.getItem('user_total_capital');
            if (storedCap) totalCapital = parseFloat(storedCap) || totalCapital;

            const storedRate = localStorage.getItem('user_usd_rate');
            if (storedRate) usdExchangeRate = parseFloat(storedRate) || usdExchangeRate;

            const stored = localStorage.getItem('user_inertia_stocks');
            if (stored) {
                try {
                    stockList = JSON.parse(stored);
                } catch (e) {
                    stockList = JSON.parse(JSON.stringify(DEFAULT_STOCKS));
                }
            } else {
                stockList = JSON.parse(JSON.stringify(DEFAULT_STOCKS));
            }
        }

        function resetToOfficialPortfolio() {
            stockList = JSON.parse(JSON.stringify(DEFAULT_STOCKS));
            totalCapital = 1500000;
            usdExchangeRate = 32.5;
            localStorage.setItem('tina_portfolio_version', CURRENT_PORTFOLIO_VERSION);
            saveToStorage();
            document.getElementById('inputTotalCapital').value = totalCapital;
            if (document.getElementById('inputAllocTotalCapital')) document.getElementById('inputAllocTotalCapital').value = totalCapital;
            document.getElementById('inputUsdRate').value = usdExchangeRate;
            renderDashboard();
            updateLineShareLink();
            Swal.fire({
                title: '已重設並同步！',
                text: '已成功載入 150 萬總預算自訂配置：台積電40%、SPY 20%、00981A 20%、主動ETF 20% 與最新戰報！',
                icon: 'success',
                timer: 2000,
                showConfirmButton: false
            });
        }

        function saveToStorage() {
            localStorage.setItem('user_inertia_stocks', JSON.stringify(stockList));
            localStorage.setItem('user_total_capital', totalCapital.toString());
            localStorage.setItem('user_usd_rate', usdExchangeRate.toString());
        }

        // 資金增減操作
        function adjustCapital(delta) {
            totalCapital = Math.max(100000, totalCapital + delta);
            document.getElementById('inputTotalCapital').value = totalCapital;
            if (document.getElementById('inputAllocTotalCapital')) document.getElementById('inputAllocTotalCapital').value = totalCapital;
            saveToStorage();
            renderDashboard();
            updateLineShareLink();
        }

        function setCapital(val) {
            totalCapital = val;
            document.getElementById('inputTotalCapital').value = totalCapital;
            if (document.getElementById('inputAllocTotalCapital')) document.getElementById('inputAllocTotalCapital').value = totalCapital;
            saveToStorage();
            renderDashboard();
            updateLineShareLink();
        }

        function onTotalCapitalChange() {
            const val = parseFloat(document.getElementById('inputTotalCapital').value) || totalCapital;
            totalCapital = Math.max(100000, val);
            if (document.getElementById('inputAllocTotalCapital')) document.getElementById('inputAllocTotalCapital').value = totalCapital;
            saveToStorage();
            renderDashboard();
            updateLineShareLink();
        }

        function updateUsdRate() {
            const val = parseFloat(document.getElementById('inputUsdRate').value) || usdExchangeRate;
            usdExchangeRate = Math.max(1, val);
            saveToStorage();
            renderDashboard();
            updateLineShareLink();
        }

        // 自動搜尋台股即時行情 (FinMind)
        async function fetchTaiwanStockQuote(symbol) {
            try {
                const cleanSym = symbol.trim().toUpperCase().replace(".TW", "").replace(".TWO", "");
                const today = new Date();
                const tenDaysAgo = new Date(today.getTime() - 20 * 86400000).toISOString().split('T')[0];
                const url = `https://api.finmindtrade.com/api/v4/data?dataset=TaiwanStockPrice&data_id=${cleanSym}&start_date=${tenDaysAgo}`;
                const resp = await fetch(url);
                if (!resp.ok) return null;
                const json = await resp.json();
                const data = json.data || [];
                if (data.length < 2) return null;
                const prev = data[data.length - 2];
                const curr = data[data.length - 1];
                return {
                    symbol: cleanSym,
                    date: curr.date,
                    close: parseFloat(curr.close),
                    open: parseFloat(curr.open),
                    high: parseFloat(curr.max),
                    low: parseFloat(curr.min),
                    prevHigh: parseFloat(prev.max),
                    prevLow: parseFloat(prev.min),
                    prevClose: parseFloat(prev.close)
                };
            } catch (e) {
                console.error("fetch quote error:", e);
                return null;
            }
        }

        // Modal 搜尋
        async function fetchQuoteInModal() {
            const sym = document.getElementById('inputSymbol').value.trim();
            if (!sym) {
                Swal.fire('請輸入股票代號', '例如: 2330 或 00981A', 'info');
                return;
            }
            Swal.fire({
                title: `正在連線搜尋 ${sym} 最新即時行情...`,
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            const quote = await fetchTaiwanStockQuote(sym);
            if (quote) {
                document.getElementById('inputClose').value = quote.close;
                document.getElementById('inputOpen').value = quote.open;
                document.getElementById('inputHigh').value = quote.high;
                document.getElementById('inputLow').value = quote.low;
                document.getElementById('inputPrevHigh').value = quote.prevHigh;
                document.getElementById('inputPrevLow').value = quote.prevLow;
                document.getElementById('inputPrevClose').value = quote.prevClose;
                if (sym.includes("2330")) {
                    document.getElementById('inputName').value = "台積電";
                    document.getElementById('inputCostPrice').value = 2350.0;
                }
                if (sym.includes("00981A")) {
                    document.getElementById('inputName').value = "主動統一台股增長";
                    document.getElementById('inputCostPrice').value = 28.50;
                }

                Swal.fire({
                    title: '行情搜尋成功！',
                    html: `<strong>${sym}</strong> 最新收盤價：<span class="text-danger fw-bold fs-5">${quote.close.toLocaleString()}</span> 元<br>昨高 ${quote.prevHigh} ｜ 昨低 ${quote.prevLow}`,
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                Swal.fire('未能取得即時報價', '請手動輸入價位或檢查股票代號。', 'warning');
            }
        }

        // 一鍵同步全市場最新即時股價
        async function syncAllLiveQuotes() {
            Swal.fire({
                title: '正在自動搜尋並更新所有股票即時行情...',
                text: '連線官方即時數據庫更新中...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            let updatedCount = 0;
            for (let i = 0; i < stockList.length; i++) {
                const s = stockList[i];
                if (s.market === 'TW') {
                    const quote = await fetchTaiwanStockQuote(s.symbol);
                    if (quote) {
                        stockList[i].close = quote.close;
                        stockList[i].open = quote.open;
                        stockList[i].high = quote.high;
                        stockList[i].low = quote.low;
                        stockList[i].prevHigh = quote.prevHigh;
                        stockList[i].prevLow = quote.prevLow;
                        stockList[i].prevClose = quote.prevClose;
                        stockList[i].date = quote.date;
                        updatedCount++;
                    }
                }
            }

            saveToStorage();
            renderDashboard();
            updateLineShareLink();
            Swal.fire({
                title: '同步完成！',
                text: `已成功即時更新 ${updatedCount} 檔股票最新報價，並完成資產淨值與停泊資金重新試算！`,
                icon: 'success',
                timer: 2000,
                showConfirmButton: false
            });
        }

        // 執行減碼並將獲利累計至停泊資金
        function executeTrimAndRealize(index) {
            const s = stockList[index];
            const spu = s.sharesPerUnit || 1;
            const unit = s.unitName || "張";
            const baseShares = Math.floor(s.targetFullShares * (s.baseRatio || 0.40));
            const premiumShares = Math.max(0, s.currentHoldingShares - baseShares);

            if (premiumShares <= 0) {
                Swal.fire('已是 40% 基本倉', '基本倉為波段護城河，依李老師紀律嚴禁賣出！', 'warning');
                return;
            }

            const cutUnits = Math.max(1, Math.floor((premiumShares / spu) / 2));
            const cutShares = cutUnits * spu;
            const cost = s.costPrice || s.close;
            const isUS = s.market === "US";
            const mult = isUS ? usdExchangeRate : 1.0;

            const recoveredCashTwd = cutShares * s.close * mult;
            const gainTwd = cutShares * (s.close - cost) * mult;

            Swal.fire({
                title: `確定執行【${s.name}】加碼倉砍半？`,
                html: `
                    <div class="text-start p-3 bg-light rounded-3 border small">
                        • 建議賣出：<strong class="text-danger">${cutUnits} ${unit}</strong> (${cutShares.toLocaleString()} 股)<br>
                        • 抽回現金 (本金+獲利)：<strong class="text-success">NT$ ${Math.round(recoveredCashTwd).toLocaleString()}</strong><br>
                        • 本次實現獲利：<strong class="${gainTwd >= 0 ? 'text-danger' : 'text-success'}">NT$ ${Math.round(gainTwd).toLocaleString()}</strong><br>
                        • 減碼後留倉：<strong>${(s.currentHoldingShares - cutShares).toLocaleString()} 股</strong> (基本倉 ${(baseShares/spu).toFixed(1)} ${unit} + 剩餘加碼)<br><br>
                        <span class="text-muted">點擊確定後，抽回的資金與實現獲利將自動全數累計至【停泊資金 (可加碼額度)】！</span>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '確定減碼入帳',
                cancelButtonText: '取消'
            }).then((res) => {
                if (res.isConfirmed) {
                    stockList[index].currentHoldingShares -= cutShares;
                    stockList[index].realizedProfit = (stockList[index].realizedProfit || 0) + Math.round(gainTwd);
                    saveToStorage();
                    renderDashboard();
                    updateLineShareLink();
                    Swal.fire({
                        title: '減碼入帳成功！',
                        text: `已抽回 NT$ ${Math.round(recoveredCashTwd).toLocaleString()} 並入帳至手頭停泊資金。`,
                        icon: 'success'
                    });
                }
            });
        }

        // 李長坤策略核心分析 (支援日K每日盯盤 與 週K每週下一單)
        function analyzeStock(s) {
            const isTW = s.market === "TW";
            const isUS = s.market === "US";
            const mult = isUS ? usdExchangeRate : 1.0;
            const isWeekly = (currentTimeframe === 'weekly');

            // 依檢視週期動態取得 K 棒高低收數據
            let open = s.open;
            let high = s.high;
            let low = s.low;
            let close = s.close;
            let prevHigh = s.prevHigh;
            let prevLow = s.prevLow;
            let prevClose = s.prevClose || s.close;

            if (isWeekly && s.weekly) {
                open = s.weekly.open ?? s.open;
                high = s.weekly.high ?? s.high;
                low = s.weekly.low ?? s.low;
                close = s.weekly.close ?? s.close;
                prevHigh = s.weekly.prevHigh ?? s.prevHigh;
                prevLow = s.weekly.prevLow ?? s.prevLow;
                prevClose = s.weekly.prevClose ?? s.prevClose ?? s.close;
            }

            const isRed = close >= open;
            const isBlack = close < open;
            const brokePrevLow = low < prevLow;
            const passedPrevHigh = high > prevHigh;

            const priceChange = close - prevClose;
            const pctChange = prevClose ? (priceChange / prevClose) * 100 : 0;

            const baseShares = Math.floor(s.targetFullShares * (s.baseRatio || 0.40));
            const dynamicTargetShares = s.targetFullShares - baseShares;
            const premiumShares = Math.max(0, s.currentHoldingShares - baseShares);
            const holdingPct = s.targetFullShares > 0 ? (s.currentHoldingShares / s.targetFullShares) * 100 : 0;

            const spu = s.sharesPerUnit || 1;
            const unit = s.unitName || (isTW ? "張" : "股");

            // 財務總價值與損益 (以最新現價計算)
            const costPrice = s.costPrice || close;
            const marketValueTwd = s.currentHoldingShares * close * mult;
            const costValueTwd = s.currentHoldingShares * costPrice * mult;
            const unrealizedProfitTwd = marketValueTwd - costValueTwd;
            const roiPct = costPrice > 0 ? ((close - costPrice) / costPrice) * 100 : 0;
            const realizedProfitTwd = s.realizedProfit || 0;

            // 基本倉與加碼倉市值
            const baseMarketValueTwd = baseShares * close * mult;
            const premiumMarketValueTwd = premiumShares * close * mult;

            let signalType = "WATCH";
            let signalTitle = "";
            let actionType = "";
            let actionShares = 0;
            let actionUnits = 0;
            let remainShares = s.currentHoldingShares;
            let actionDesc = "";
            let actionAmountTwd = 0;

            let buyPriceTrigger = prevHigh;
            let sellPriceTrigger = prevLow;

            const periodName = isWeekly ? "週" : "日";
            const prevPeriodName = isWeekly ? "前週" : "昨日";
            const currPeriodName = isWeekly ? "本週" : "今日";
            const nextPeriodName = isWeekly ? "下週" : "明日";
            const execAdvice = isWeekly ? "（每週下一單，建議於週五收盤前或週一開盤執行）" : "（每日盤中即時執行）";

            if (brokePrevLow) {
                if (premiumShares > 0) {
                    signalType = "SELL";
                    signalTitle = isWeekly ? "【週K向下慣性 - 觸發每週減碼訊號】" : "【向下慣性 - 觸發減碼訊號】";
                    actionType = "減碼 (加碼倉砍半)";
                    
                    const premiumUnits = premiumShares / spu;
                    actionUnits = Math.max(1, Math.floor(premiumUnits / 2));
                    actionShares = actionUnits * spu;
                    remainShares = s.currentHoldingShares - actionShares;
                    actionAmountTwd = actionShares * close * mult;

                    actionDesc = `${currPeriodName}最低價跌破${prevPeriodName}低點（${low.toFixed(2)} < ${prevPeriodName}低 ${prevLow.toFixed(2)}），向下連續性確立！${execAdvice}
SOP 執行指令：立即賣出加碼倉（折溢部位）的 50%，鎖住波段利潤！
👉 建議賣出：<strong>${actionUnits} ${unit}</strong>（約 ${actionShares.toLocaleString()} 股）。
👉 建議賣出價：破${prevPeriodName}低 <strong>${sellPriceTrigger.toFixed(2)}</strong> 停利減碼。
👉 抽回至停泊資金：<strong>NT$ ${Math.round(actionAmountTwd).toLocaleString()}</strong>。
👉 減碼後留倉：<strong>${remainShares.toLocaleString()} 股</strong>（保留 40% 底倉 ${(baseShares/spu).toFixed(1)} ${unit} 絕對不賣）。`;
                } else {
                    signalType = "HOLD_BASE";
                    signalTitle = isWeekly ? "【週K觸發破低防守 - 已達基本倉40%】" : "【觸發破低防守 - 已達基本倉40%】";
                    actionType = "防守不賣";
                    actionDesc = `${currPeriodName}雖跌破${prevPeriodName}低，但目前已退守至 40% 基本倉（${s.currentHoldingShares.toLocaleString()} 股）。
SOP 執行指令：基本倉為波段種子，大盤拉回絕對不賣出！停止減碼動作，等待黑轉紅轉強訊號。`;
                }
            } else if (passedPrevHigh) {
                signalType = "BUY";
                signalTitle = isWeekly ? "【週K向上慣性 - 觸發每週加碼訊號】" : "【向上慣性 - 觸發加碼訊號】";
                actionType = "順勢加碼";

                if (s.currentHoldingShares < baseShares) {
                    actionShares = Math.floor(baseShares * 0.08);
                    actionUnits = Math.round((actionShares / spu) * 10) / 10;
                    remainShares = s.currentHoldingShares + actionShares;
                    actionAmountTwd = actionShares * close * mult;
                    actionDesc = `${currPeriodName}突破${prevPeriodName}高（最高 ${high.toFixed(2)} > ${prevPeriodName}高 ${prevHigh.toFixed(2)}），基本倉建倉訊號浮現！${execAdvice}
👉 建議買進：<strong>${actionUnits} ${unit}</strong>（約 ${actionShares.toLocaleString()} 股）。
👉 需動用停泊資金：<strong>NT$ ${Math.round(actionAmountTwd).toLocaleString()}</strong>。
👉 買入觸發價：盤中突破過${prevPeriodName}高 <strong>${buyPriceTrigger.toFixed(2)}</strong> 進場。`;
                } else {
                    if (premiumShares === 0) {
                        actionShares = Math.floor(dynamicTargetShares * 0.08);
                    } else {
                        actionShares = Math.min(premiumShares, s.targetFullShares - s.currentHoldingShares);
                        if (actionShares === 0) actionShares = Math.floor(dynamicTargetShares * 0.08);
                    }
                    actionShares = Math.min(actionShares, s.targetFullShares - s.currentHoldingShares);
                    actionUnits = Math.round((actionShares / spu) * 10) / 10;
                    remainShares = s.currentHoldingShares + actionShares;
                    actionAmountTwd = actionShares * close * mult;

                    if (s.currentHoldingShares >= s.targetFullShares) {
                        actionDesc = `${currPeriodName}過${prevPeriodName}高（最高 ${high.toFixed(2)} > ${prevPeriodName}高 ${prevHigh.toFixed(2)}），已達 100% 滿倉（${s.currentHoldingShares.toLocaleString()} 股），請抱牢獲利！
SOP 執行指令：順勢續抱，警戒${nextPeriodName}是否破低即可。`;
                    } else {
                        actionDesc = `${currPeriodName}突破過${prevPeriodName}高（最高 ${high.toFixed(2)} > ${prevPeriodName}高 ${prevHigh.toFixed(2)}），向上慣性成立！${execAdvice}
SOP 執行指令：啟動順勢動態加碼！
👉 建議加碼：<strong>${actionUnits} ${unit}</strong>（約 ${actionShares.toLocaleString()} 股）。
👉 需動用停泊資金：<strong>NT$ ${Math.round(actionAmountTwd).toLocaleString()}</strong>。
👉 加碼觸發價：突破過${prevPeriodName}高 <strong>${buyPriceTrigger.toFixed(2)}</strong> 時進場。
👉 加碼後部位：<strong>${remainShares.toLocaleString()} 股</strong>（約 ${(remainShares/spu).toFixed(1)} ${unit}）。`;
                    }
                }
            } else {
                signalType = "WATCH";
                signalTitle = isWeekly ? "【週K區間整理 - 觀望續抱】" : "【區間整理 - 觀望續抱】";
                actionType = "持股觀望";
                actionDesc = `${currPeriodName}走勢未破${prevPeriodName}低（${prevPeriodName}低 ${prevLow.toFixed(2)}），亦未突破${prevPeriodName}高（${prevPeriodName}高 ${prevHigh.toFixed(2)}）。
SOP 執行指令：不破低、不動作，維持現有持股觀望續抱，資金留作停泊現金儲備。`;
            }

            // 資產配置試算 (依自訂比例 %)
            const allocationRatio = s.allocationRatio !== undefined ? s.allocationRatio : 20;
            const targetBudgetTwd = totalCapital * (allocationRatio / 100);
            const baseBudgetTwd = targetBudgetTwd * (s.baseRatio || 0.40);
            const dynamicBudgetTwd = targetBudgetTwd - baseBudgetTwd;
            const stockParkedCashTwd = Math.max(0, targetBudgetTwd - marketValueTwd);
            const shortfallBaseTwd = Math.max(0, baseBudgetTwd - marketValueTwd);
            const priceTwd = close * mult;
            const shortfallBaseShares = priceTwd > 0 ? Math.ceil(shortfallBaseTwd / priceTwd) : 0;
            const targetBaseShares = priceTwd > 0 ? Math.ceil(baseBudgetTwd / priceTwd) : 0;
            const targetTotalShares = priceTwd > 0 ? Math.ceil(targetBudgetTwd / priceTwd) : 0;

            // 自訂資產配置與 SOP 診斷指令 (配合自填持有股數與購入成本)
            let allocStatusTag = "";
            let allocAdviceText = "";

            if (s.currentHoldingShares === 0) {
                if (passedPrevHigh) {
                    allocStatusTag = `<span class="badge bg-success mb-1"><i class="fa-solid fa-arrow-trend-up me-1"></i>過高！啟動初次建倉</span>`;
                    allocAdviceText = `<strong>盤中突破過高！</strong>可動用資金建立 40% 底倉（應建 NT$ ${Math.round(baseBudgetTwd).toLocaleString()}，約 ${targetBaseShares.toLocaleString()} 股）。第一筆可先建 8% 試水溫！`;
                } else {
                    allocStatusTag = `<span class="badge bg-secondary mb-1"><i class="fa-solid fa-hourglass-start me-1"></i>空手觀望中</span>`;
                    allocAdviceText = `尚未建立部位。40% 底倉預算為 NT$ ${Math.round(baseBudgetTwd).toLocaleString()}（約 ${targetBaseShares.toLocaleString()} 股），待日/週K出現轉折紅K或突破前高時分批建倉。`;
                }
            } else if (marketValueTwd < baseBudgetTwd) {
                const fillPct = baseBudgetTwd > 0 ? ((marketValueTwd / baseBudgetTwd) * 100).toFixed(0) : 0;
                if (brokePrevLow) {
                    allocStatusTag = `<span class="badge bg-warning text-dark mb-1"><i class="fa-solid fa-shield-halved me-1"></i>底倉防守 (拉回不賣)</span>`;
                    allocAdviceText = `現有部位佔 40% 底倉 <strong>${fillPct}%</strong>。走勢雖破低拉回，但<strong>40%底倉為護城河，拉回絕對不賣出！</strong>停止加碼，耐心等待止跌回升。`;
                } else if (passedPrevHigh) {
                    allocStatusTag = `<span class="badge bg-success mb-1"><i class="fa-solid fa-plus me-1"></i>過高！補齊40%底倉</span>`;
                    allocAdviceText = `突破過高向上慣性！建議動用停泊資金加碼 <strong>${Math.min(shortfallBaseShares, Math.max(1, Math.ceil(targetBaseShares * 0.08))).toLocaleString()} 股</strong>，逐步填滿 40% 底倉目標（尚缺 ${shortfallBaseShares.toLocaleString()} 股）。`;
                } else {
                    allocStatusTag = `<span class="badge bg-info text-white mb-1"><i class="fa-solid fa-layer-group me-1"></i>底倉建立中 (${fillPct}%)</span>`;
                    allocAdviceText = `目前市值已建 <strong>${fillPct}%</strong> 底倉，尚缺 NT$ ${Math.round(shortfallBaseTwd).toLocaleString()}（約 ${shortfallBaseShares.toLocaleString()} 股）。未破低續抱，等待轉強加滿 40%。`;
                }
            } else if (marketValueTwd >= baseBudgetTwd && marketValueTwd < targetBudgetTwd) {
                const totalFillPct = targetBudgetTwd > 0 ? ((marketValueTwd / targetBudgetTwd) * 100).toFixed(0) : 0;
                if (brokePrevLow) {
                    allocStatusTag = `<span class="badge bg-danger mb-1"><i class="fa-solid fa-arrow-down me-1"></i>破低！加碼倉砍半</span>`;
                    allocAdviceText = `40% 底倉已穩固！短線跌破低點，<strong>請將加碼倉砍半（賣出 50% 折溢部位）</strong>，40% 底倉雷打不動堅決續抱，抽回資金回補停泊金額！`;
                } else if (passedPrevHigh) {
                    allocStatusTag = `<span class="badge bg-success mb-1"><i class="fa-solid fa-bolt me-1"></i>過高！動態順勢加碼</span>`;
                    allocAdviceText = `40% 底倉健全，且突破過高慣性向上！可動用剩餘可加碼金額（尚餘 NT$ ${Math.round(stockParkedCashTwd).toLocaleString()}）階梯式順勢加碼！`;
                } else {
                    allocStatusTag = `<span class="badge bg-primary mb-1"><i class="fa-solid fa-circle-check me-1"></i>40%底倉穩固 ｜ 續抱</span>`;
                    allocAdviceText = `40% 底倉已達標，整體已運用 <strong>${totalFillPct}%</strong> 預算。區間整理未破低，安心續抱讓獲利發酵；手頭停泊款 NT$ ${Math.round(stockParkedCashTwd).toLocaleString()} 待命。`;
                }
            } else {
                if (brokePrevLow) {
                    allocStatusTag = `<span class="badge bg-danger mb-1"><i class="fa-solid fa-hand-holding-dollar me-1"></i>滿倉破低 ｜ 減碼鎖利</span>`;
                    allocAdviceText = `已達 100% 滿倉！跌破低點轉弱，<strong>立即賣出加碼部位的 50%</strong> 鎖住利潤，40% 底倉續留！`;
                } else {
                    allocStatusTag = `<span class="badge text-white mb-1" style="background:#8b5cf6;"><i class="fa-solid fa-trophy me-1"></i>100% 滿倉大贏家</span>`;
                    allocAdviceText = `該標的已達 100% 滿額配置！慣性維持強勢，抱緊波段持股，僅須在跌破低點時依 SOP 啟動減碼。`;
                }
            }

            return {
                ...s,
                open,
                high,
                low,
                close,
                prevHigh,
                prevLow,
                prevClose,
                isWeekly,
                isRed,
                isBlack,
                brokePrevLow,
                passedPrevHigh,
                priceChange,
                pctChange,
                baseShares,
                premiumShares,
                holdingPct,
                costPrice,
                marketValueTwd,
                costValueTwd,
                unrealizedProfitTwd,
                roiPct,
                realizedProfitTwd,
                baseMarketValueTwd,
                premiumMarketValueTwd,
                signalType,
                signalTitle,
                actionType,
                actionShares,
                actionUnits,
                remainShares,
                actionDesc,
                actionAmountTwd,
                buyPriceTrigger,
                sellPriceTrigger,
                tomorrowBreakout: high,
                tomorrowDefense: low,
                allocationRatio,
                targetBudgetTwd,
                baseBudgetTwd,
                dynamicBudgetTwd,
                stockParkedCashTwd,
                shortfallBaseTwd,
                shortfallBaseShares,
                targetBaseShares,
                targetTotalShares,
                allocStatusTag,
                allocAdviceText
            };
        }

        // 渲染儀表板
        function renderDashboard() {
            document.getElementById('inputTotalCapital').value = totalCapital;
            document.getElementById('inputUsdRate').value = usdExchangeRate;

            const container = document.getElementById('stockCardsContainer');
            container.innerHTML = "";

            let totalMarketValueTwd = 0;
            let totalCostValueTwd = 0;
            let totalUnrealizedProfitTwd = 0;
            let totalRealizedProfitTwd = 0;
            let totalAddCostTwd = 0;
            let totalRecoverCashTwd = 0;

            let buyCount = 0;
            let sellCount = 0;

            const isWeekly = (currentTimeframe === 'weekly');
            const prevLabel = isWeekly ? '前週最高 / 最低' : '昨日高 / 低';
            const currLabel = isWeekly ? '本週最高 / 最低' : '今日高 / 低';
            const nextDecisionTitle = isWeekly ? '下週關鍵決策線（週波段買賣觸發價）：' : '明日關鍵決策線（反轉／加減碼價格）：';
            const nextBuyLabel = isWeekly ? '▲ 下週過高加碼買入價：' : '▲ 向上加碼買入價：';
            const nextSellLabel = isWeekly ? '▼ 下週破低減碼賣出價：' : '▼ 向下減碼賣出價：';
            const kLineLabel = isWeekly ? '週K棒' : '日K棒';

            stockList.forEach((rawStock, index) => {
                const s = analyzeStock(rawStock);
                if (s.signalType === "BUY") {
                    buyCount++;
                    totalAddCostTwd += s.actionAmountTwd;
                }
                if (s.signalType === "SELL") {
                    sellCount++;
                    totalRecoverCashTwd += s.actionAmountTwd;
                }

                totalMarketValueTwd += s.marketValueTwd;
                totalCostValueTwd += s.costValueTwd;
                totalUnrealizedProfitTwd += s.unrealizedProfitTwd;
                totalRealizedProfitTwd += s.realizedProfitTwd;

                const isTW = s.market === "TW";
                const chgColor = s.pctChange >= 0 ? (isTW ? "text-danger" : "text-success") : (isTW ? "text-success" : "text-danger");
                const chgSign = s.pctChange >= 0 ? "+" : "";

                const signalClass = {
                    "SELL": "signal-sell-box",
                    "BUY": "signal-buy-box",
                    "HOLD_BASE": "signal-holdbase-box",
                    "WATCH": "signal-watch-box"
                }[s.signalType];

                const signalBadge = {
                    "SELL": `<span class="badge bg-danger rounded-pill px-3 py-2"><i class="fa-solid fa-arrow-down me-1"></i>${isWeekly ? '週K減碼 (砍半)' : '減碼 (砍半)'}</span>`,
                    "BUY": `<span class="badge bg-success rounded-pill px-3 py-2"><i class="fa-solid fa-arrow-up me-1"></i>${isWeekly ? '週K加碼 (噴出)' : '加碼 (噴出)'}</span>`,
                    "HOLD_BASE": `<span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="fa-solid fa-shield me-1"></i>40% 基本倉防守</span>`,
                    "WATCH": `<span class="badge bg-info text-white rounded-pill px-3 py-2"><i class="fa-solid fa-eye me-1"></i>${isWeekly ? '週K觀望續抱' : '觀望續抱'}</span>`
                }[s.signalType];

                const unrealClass = s.unrealizedProfitTwd >= 0 ? "profit-pos" : "profit-neg";

                const cardHtml = `
                    <div class="col-lg-6">
                        <div class="stock-card h-100 p-4">
                            <!-- 頂部標頭與操作選單 -->
                            <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-dark fs-6 px-2 py-1">${s.symbol}</span>
                                        <h3 class="h4 fw-bold mb-0 text-dark">${s.name}</h3>
                                        <span class="badge ${isWeekly ? 'bg-purple text-white' : 'bg-primary'} rounded-pill px-2 py-1 small" style="${isWeekly ? 'background-color:#9333ea;' : ''}">
                                            ${isWeekly ? '週K長波段' : '日K短波段'}
                                        </span>
                                    </div>
                                    <span class="text-muted small">市場：${s.market === 'TW' ? '台股' : '美股'} ｜ 單位：${s.unitName}</span>
                                </div>
                                <div class="text-end">
                                    <div class="mb-2">${signalBadge}</div>
                                    <div>
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" onclick="editStock(${index})" title="調整成本與持倉">
                                            <i class="fa-solid fa-pen me-1"></i>修改
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" onclick="deleteStock(${index})" title="刪除此股票">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- 即時報價與K棒 -->
                            <div class="d-flex justify-content-between align-items-baseline mb-3">
                                <div>
                                    <span class="display-6 fw-bold text-dark">${s.close.toFixed(2)}</span>
                                    <span class="ms-2 fs-6 fw-bold ${chgColor}">${chgSign}${s.priceChange.toFixed(2)} (${chgSign}${s.pctChange.toFixed(2)}%)</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge ${s.isRed ? 'badge-tw-red' : 'badge-tw-green'} px-2 py-1 small">
                                        ${s.isRed ? `🔴 紅K (${kLineLabel}陽)` : `🟢 黑K (${kLineLabel}陰)`}
                                    </span>
                                    <div class="text-muted x-small" style="font-size: 0.75rem;">開盤 ${s.open.toFixed(2)} ➔ 最新 ${s.close.toFixed(2)}</div>
                                </div>
                            </div>

                            <!-- 財務價值、預估利潤與成效面板 -->
                            <div class="p-3 rounded-3 mb-3" style="background: #f1f5f9; border: 1px solid #cbd5e1;">
                                <div class="row g-2 text-center">
                                    <div class="col-4">
                                        <span class="text-muted x-small d-block">留倉總市值 (NTD)</span>
                                        <strong class="text-dark fs-6">NT$ ${Math.round(s.marketValueTwd).toLocaleString()}</strong>
                                        <span class="x-small text-muted d-block">${s.currentHoldingShares.toLocaleString()} 股</span>
                                    </div>
                                    <div class="col-4">
                                        <span class="text-muted x-small d-block">預估利潤 (成效)</span>
                                        <strong class="${unrealClass} fs-6">${s.unrealizedProfitTwd >= 0 ? '+' : ''}NT$ ${Math.round(s.unrealizedProfitTwd).toLocaleString()}</strong>
                                        <span class="x-small ${unrealClass} d-block">(${s.roiPct >= 0 ? '+' : ''}${s.roiPct.toFixed(1)}%)</span>
                                    </div>
                                    <div class="col-4">
                                        <span class="text-muted x-small d-block">累計已實現獲利</span>
                                        <strong class="text-success fs-6">NT$ ${Math.round(s.realizedProfitTwd).toLocaleString()}</strong>
                                        <span class="x-small text-success d-block">已入帳停泊</span>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between x-small text-muted border-top border-secondary-subtle pt-2 mt-2">
                                    <span>平均成本：<strong>${s.costPrice.toFixed(2)}</strong></span>
                                    <span>40% 底倉價值：<strong>NT$ ${Math.round(s.baseMarketValueTwd).toLocaleString()}</strong></span>
                                    <span>加碼倉價值：<strong>NT$ ${Math.round(s.premiumMarketValueTwd).toLocaleString()}</strong></span>
                                </div>
                            </div>

                            <!-- 昨今 (或前後週) 高低比對 -->
                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <div class="metric-cell">
                                        <div class="text-muted small">${prevLabel}</div>
                                        <div class="fw-bold text-dark">${s.prevHigh.toFixed(2)} / ${s.prevLow.toFixed(2)}</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="metric-cell">
                                        <div class="text-muted small">${currLabel}</div>
                                        <div class="fw-bold text-dark">${s.high.toFixed(2)} / ${s.low.toFixed(2)}</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="metric-cell">
                                        <div class="text-muted small">慣性突破檢驗</div>
                                        <div>
                                            <span class="badge ${s.passedPrevHigh ? 'bg-success' : 'bg-secondary'}">${s.passedPrevHigh ? (isWeekly ? '過前週高' : '過昨高') : (isWeekly ? '未過週高' : '未過高')}</span>
                                            <span class="badge ${s.brokePrevLow ? 'bg-danger' : 'bg-secondary'}">${s.brokePrevLow ? (isWeekly ? '破前週低' : '破昨低') : (isWeekly ? '未破週低' : '未破低')}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 倉位分佈進度條 -->
                            <div class="p-3 bg-light rounded-3 mb-3 border">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>目前持股：<strong>${s.holdingPct.toFixed(1)}%</strong> (${s.currentHoldingShares.toLocaleString()} 股 / ${(s.currentHoldingShares/s.sharesPerUnit).toFixed(1)} ${s.unitName})</span>
                                    <span>滿倉目標：${s.targetFullShares.toLocaleString()} 股 (${(s.targetFullShares/s.sharesPerUnit).toFixed(1)} ${s.unitName})</span>
                                </div>
                                <div class="progress progress-thin mb-2">
                                    <div class="progress-bar bg-primary" style="width: ${Math.min(s.baseRatio*100, s.holdingPct)}%;" title="基本防守倉">基本倉 ${(s.baseRatio*100).toFixed(0)}%</div>
                                    <div class="progress-bar bg-warning" style="width: ${Math.max(0, s.holdingPct - (s.baseRatio*100))}%;" title="動態加碼倉">加碼倉</div>
                                </div>
                                <div class="d-flex justify-content-between small" style="font-size: 0.8rem;">
                                    <span>🛡️ 基本防守倉 (${(s.baseRatio*100).toFixed(0)}%)：<strong>${s.baseShares.toLocaleString()} 股</strong></span>
                                    <span>⚡ 動態加碼倉 (折溢)：<strong class="text-primary">${s.premiumShares.toLocaleString()} 股</strong></span>
                                </div>
                            </div>

                            <!-- SOP 執行指令與具體加減金額建議 -->
                            <div class="${signalClass} mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="fw-bold fs-6">
                                        <i class="fa-solid fa-bullhorn me-1"></i>${s.signalTitle}
                                    </div>
                                    ${s.signalType === 'SELL' && s.premiumShares > 0 ? `
                                        <button class="btn btn-sm btn-danger rounded-pill px-3 py-1 fw-bold shadow-sm" onclick="executeTrimAndRealize(${index})">
                                            <i class="fa-solid fa-hand-holding-dollar me-1"></i>執行減碼入帳
                                        </button>
                                    ` : ''}
                                </div>
                                <div class="small" style="white-space: pre-line;">${s.actionDesc}</div>
                            </div>

                            <!-- 下週期決策觸發點 -->
                            <div class="p-3 bg-white rounded-3 border">
                                <div class="fw-bold text-dark small mb-2"><i class="fa-solid fa-compass text-primary me-1"></i>${nextDecisionTitle}</div>
                                <div class="row g-2 small">
                                    <div class="col-6">
                                        <div class="p-2 rounded bg-light border-start border-success border-3">
                                            <span class="text-success fw-bold">${nextBuyLabel}</span><br>
                                            突破 <strong>${s.tomorrowBreakout.toFixed(2)}</strong> 且收紅
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="p-2 rounded bg-light border-start border-danger border-3">
                                            <span class="text-danger fw-bold">${nextSellLabel}</span><br>
                                            跌破 <strong>${s.tomorrowDefense.toFixed(2)}</strong> 砍半
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += cardHtml;
            });

            // 停泊資金 = 總資本 + 累計已實現獲利 - 留倉總市值
            const parkedCashTwd = (totalCapital + totalRealizedProfitTwd) - totalMarketValueTwd;
            const equityRatio = (totalCapital + totalRealizedProfitTwd) > 0 ? (totalMarketValueTwd / (totalCapital + totalRealizedProfitTwd)) * 100 : 0;
            const cashRatio = (totalCapital + totalRealizedProfitTwd) > 0 ? (parkedCashTwd / (totalCapital + totalRealizedProfitTwd)) * 100 : 0;
            const totalRoi = totalCostValueTwd > 0 ? (totalUnrealizedProfitTwd / totalCostValueTwd) * 100 : 0;

            // 更新頂部 KPI
            document.getElementById('kpiTotalCapital').innerText = `NT$ ${Math.round(totalCapital).toLocaleString()}`;
            document.getElementById('kpiMarketValue').innerText = `NT$ ${Math.round(totalMarketValueTwd).toLocaleString()}`;
            document.getElementById('kpiEquityRatio').innerText = `資金水位 ${equityRatio.toFixed(1)}%`;
            
            const unrealEl = document.getElementById('kpiUnrealizedProfit');
            unrealEl.innerText = `${totalUnrealizedProfitTwd >= 0 ? '+' : ''}NT$ ${Math.round(totalUnrealizedProfitTwd).toLocaleString()}`;
            unrealEl.className = `h4 fw-bold mb-0 mt-1 ${totalUnrealizedProfitTwd >= 0 ? 'text-danger' : 'text-success'}`;
            document.getElementById('kpiTotalRoi').innerText = `整體報酬率 ${totalRoi >= 0 ? '+' : ''}${totalRoi.toFixed(2)}%`;

            document.getElementById('kpiParkedCash').innerText = `NT$ ${Math.round(parkedCashTwd).toLocaleString()}`;
            document.getElementById('kpiRealizedNote').innerText = `含累計實現獲利 NT$ ${Math.round(totalRealizedProfitTwd).toLocaleString()}`;

            // 更新比例條
            document.getElementById('barEquityText').innerText = `NT$ ${Math.round(totalMarketValueTwd).toLocaleString()} (${equityRatio.toFixed(1)}%)`;
            document.getElementById('barCashText').innerText = `NT$ ${Math.round(parkedCashTwd).toLocaleString()} (${cashRatio.toFixed(1)}%)`;
            document.getElementById('barEquity').style.width = `${Math.min(100, Math.max(0, equityRatio))}%`;
            document.getElementById('barCash').style.width = `${Math.min(100, Math.max(0, cashRatio))}%`;

            // 更新調倉變動摘要
            document.getElementById('sumAddCost').innerText = `NT$ ${Math.round(totalAddCostTwd).toLocaleString()}`;
            document.getElementById('sumRecoverCash').innerText = `NT$ ${Math.round(totalRecoverCashTwd).toLocaleString()}`;
            document.getElementById('sumPostCash').innerText = `NT$ ${Math.round(parkedCashTwd - totalAddCostTwd + totalRecoverCashTwd).toLocaleString()}`;

            // 即時渲染資產配置中樞與自訂比例試算盤
            renderAllocationHub();
        }

        const ALLOC_PALETTE = [
            { bg: '#2563eb', text: '#ffffff' }, // 藍
            { bg: '#059669', text: '#ffffff' }, // 綠
            { bg: '#0891b2', text: '#ffffff' }, // 青
            { bg: '#d97706', text: '#ffffff' }, // 琥珀
            { bg: '#7c3aed', text: '#ffffff' }, // 紫
            { bg: '#db2777', text: '#ffffff' }, // 粉
            { bg: '#4b5563', text: '#ffffff' }, // 灰
            { bg: '#dc2626', text: '#ffffff' }  // 紅
        ];

        // 渲染資產配置中樞與自訂比例試算盤
        function renderAllocationHub() {
            const tableBody = document.getElementById('allocationTableBody');
            const tableFooter = document.getElementById('allocationTableFooter');
            const progressBar = document.getElementById('allocMultiProgressBar');
            const legendBox = document.getElementById('allocLegendBox');
            const badgeEl = document.getElementById('totalAllocationBadge');
            const progressText = document.getElementById('allocProgressText');
            const capitalInput = document.getElementById('inputAllocTotalCapital');

            if (!tableBody || !tableFooter) return;

            if (capitalInput && document.activeElement !== capitalInput) {
                capitalInput.value = totalCapital;
            }

            let totalAllocRatio = 0;
            let totalTargetBudget = 0;
            let totalBaseBudget = 0;
            let totalDynamicBudget = 0;
            let totalAllocMarketValue = 0;
            let totalAllocCostValue = 0;
            let totalAllocUnrealized = 0;
            let totalAllocParkedCash = 0;

            let rowsHtml = "";
            let barHtml = "";
            let legendHtml = "";

            stockList.forEach((raw, idx) => {
                const s = analyzeStock(raw);
                const color = ALLOC_PALETTE[idx % ALLOC_PALETTE.length];
                const ratio = s.allocationRatio !== undefined ? s.allocationRatio : 20;
                const isTW = s.market === "TW";
                const isUS = s.market === "US";
                const mult = isUS ? usdExchangeRate : 1.0;
                const unrealClass = s.unrealizedProfitTwd >= 0 ? "text-danger" : "text-success";
                const roiSign = s.roiPct >= 0 ? "+" : "";
                const profitSign = s.unrealizedProfitTwd >= 0 ? "+" : "";

                totalAllocRatio += ratio;
                totalTargetBudget += s.targetBudgetTwd;
                totalBaseBudget += s.baseBudgetTwd;
                totalDynamicBudget += s.dynamicBudgetTwd;
                totalAllocMarketValue += s.marketValueTwd;
                totalAllocCostValue += s.costValueTwd;
                totalAllocUnrealized += s.unrealizedProfitTwd;
                totalAllocParkedCash += s.stockParkedCashTwd;

                if (ratio > 0) {
                    barHtml += `
                        <div class="progress-bar fw-bold" role="progressbar" style="width: ${ratio}%; background-color: ${color.bg}; color: ${color.text}; font-size: 0.75rem;" title="${s.name} ${ratio}%">
                            ${ratio >= 8 ? `${s.symbol} ${ratio}%` : `${ratio}%`}
                        </div>
                    `;
                }

                legendHtml += `
                    <span class="alloc-legend-pill">
                        <span class="alloc-legend-dot me-1" style="background-color: ${color.bg};"></span>
                        <strong>${s.name} (${s.symbol})</strong>: ${ratio}% (NT$ ${Math.round(s.targetBudgetTwd).toLocaleString()})
                    </span>
                `;

                rowsHtml += `
                    <tr>
                        <!-- 投資選項 (標的) -->
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="alloc-legend-dot" style="background-color: ${color.bg};"></span>
                                <div>
                                    <strong class="text-dark fs-6">${s.name}</strong>
                                    <span class="badge bg-dark ms-1">${s.symbol}</span>
                                    <div class="x-small text-muted">
                                        ${isTW ? '台股' : '美股'} ｜ 現價 <strong>${s.close.toFixed(2)}</strong> ${isUS ? `(約 NT$ ${Math.round(s.close * mult).toLocaleString()})` : '元'}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <!-- 欲投資比例 -->
                        <td class="text-center">
                            <div class="input-group input-group-sm d-inline-flex justify-content-center" style="width: 90px;">
                                <input type="number" min="0" max="100" class="form-control form-control-sm alloc-input-ratio fw-bold" 
                                       value="${ratio}" 
                                       onchange="onAllocRatioChange(${idx}, this.value)">
                                <span class="input-group-text px-1 bg-white">%</span>
                            </div>
                        </td>
                        <!-- 分配總預算 -->
                        <td class="text-end">
                            <strong class="text-dark">NT$ ${Math.round(s.targetBudgetTwd).toLocaleString()}</strong>
                            <div class="x-small text-muted">滿倉約 ${s.targetTotalShares.toLocaleString()} 股</div>
                        </td>
                        <!-- 應建倉金額 (40%底倉) -->
                        <td class="text-end" style="background-color: #f8fafc;">
                            <strong class="text-primary">NT$ ${Math.round(s.baseBudgetTwd).toLocaleString()}</strong>
                            <div class="x-small text-muted">應建底倉約 ${s.targetBaseShares.toLocaleString()} 股</div>
                        </td>
                        <!-- 可加碼金額 (60%動態) -->
                        <td class="text-end">
                            <strong class="text-warning text-dark">NT$ ${Math.round(s.dynamicBudgetTwd).toLocaleString()}</strong>
                            <div class="x-small text-muted">階梯加碼動態額度</div>
                        </td>
                        <!-- 目前持有股數 (可自填) -->
                        <td class="text-end">
                            <input type="number" min="0" step="1" class="form-control form-control-sm alloc-input-holding fw-bold ms-auto" 
                                   value="${s.currentHoldingShares}" 
                                   onchange="onAllocHoldingChange(${idx}, this.value)">
                            <div class="x-small text-muted mt-1">${(s.currentHoldingShares / (s.sharesPerUnit || 1)).toFixed(1)} ${s.unitName || '股'}</div>
                        </td>
                        <!-- 平均購入價位 (可自填) -->
                        <td class="text-end">
                            <input type="number" min="0" step="0.01" class="form-control form-control-sm alloc-input-cost fw-bold ms-auto" 
                                   value="${s.costPrice || s.close}" 
                                   onchange="onAllocCostChange(${idx}, this.value)">
                            <div class="x-small text-muted mt-1">成本均價</div>
                        </td>
                        <!-- 留倉總市值 -->
                        <td class="text-end">
                            <strong class="text-dark">NT$ ${Math.round(s.marketValueTwd).toLocaleString()}</strong>
                            <div class="x-small text-muted">本金 NT$ ${Math.round(s.costValueTwd).toLocaleString()}</div>
                        </td>
                        <!-- 報酬率 (獲利) -->
                        <td class="text-end">
                            <strong class="${unrealClass} fs-6">${roiSign}${s.roiPct.toFixed(1)}%</strong>
                            <div class="x-small ${unrealClass}">${profitSign}NT$ ${Math.round(s.unrealizedProfitTwd).toLocaleString()}</div>
                        </td>
                        <!-- 停泊金額 (未動用) -->
                        <td class="text-end" style="background-color: #f0fdf4;">
                            <strong class="text-success fs-6">NT$ ${Math.round(s.stockParkedCashTwd).toLocaleString()}</strong>
                            <div class="x-small text-muted">佔標的預算 ${s.targetBudgetTwd > 0 ? ((s.stockParkedCashTwd / s.targetBudgetTwd) * 100).toFixed(0) : 0}%</div>
                        </td>
                        <!-- SOP 投資建議與診斷指令 -->
                        <td style="max-width: 320px;">
                            <div class="p-2 rounded-2 bg-light border small">
                                ${s.allocStatusTag}
                                <div class="x-small text-secondary" style="line-height: 1.4;">${s.allocAdviceText}</div>
                            </div>
                        </td>
                    </tr>
                `;
            });

            tableBody.innerHTML = rowsHtml;

            // 底部總計
            const totalAllocRoi = totalAllocCostValue > 0 ? ((totalAllocMarketValue - totalAllocCostValue) / totalAllocCostValue) * 100 : 0;
            const totalUnrealClass = totalAllocUnrealized >= 0 ? "text-danger" : "text-success";
            tableFooter.innerHTML = `
                <tr class="table-dark text-white">
                    <td class="text-center fw-bold">全投資組合合計</td>
                    <td class="text-center fw-bold ${totalAllocRatio === 100 ? 'text-success' : 'text-warning'}">${totalAllocRatio}%</td>
                    <td class="text-end text-warning fw-bold">NT$ ${Math.round(totalTargetBudget).toLocaleString()}</td>
                    <td class="text-end text-info fw-bold">NT$ ${Math.round(totalBaseBudget).toLocaleString()}</td>
                    <td class="text-end text-light fw-bold">NT$ ${Math.round(totalDynamicBudget).toLocaleString()}</td>
                    <td class="text-center text-muted" colspan="2">各標的即時持倉與成本</td>
                    <td class="text-end fw-bold">NT$ ${Math.round(totalAllocMarketValue).toLocaleString()}</td>
                    <td class="text-end fw-bold ${totalUnrealClass}">
                        ${totalAllocRoi >= 0 ? '+' : ''}${totalAllocRoi.toFixed(1)}%<br>
                        <span class="x-small fw-normal">(${totalAllocUnrealized >= 0 ? '+' : ''}NT$ ${Math.round(totalAllocUnrealized).toLocaleString()})</span>
                    </td>
                    <td class="text-end text-success fw-bold fs-6">NT$ ${Math.round(totalAllocParkedCash).toLocaleString()}</td>
                    <td class="small text-light opacity-90">
                        💡 總停泊資金 NT$ ${Math.round(totalAllocParkedCash).toLocaleString()}，備戰隨時順勢加碼！
                    </td>
                </tr>
            `;

            // 進度條與圖例
            if (progressBar) progressBar.innerHTML = barHtml || '<div class="progress-bar bg-secondary" style="width:100%">未配置</div>';
            if (legendBox) legendBox.innerHTML = legendHtml;

            // 比例合計標籤
            if (badgeEl) {
                if (totalAllocRatio === 100) {
                    badgeEl.className = "badge bg-success px-3 py-2 rounded-pill fs-6";
                    badgeEl.innerHTML = `<i class="fa-solid fa-circle-check me-1"></i>配置比例合計：100% (完美平衡)`;
                } else if (totalAllocRatio > 100) {
                    badgeEl.className = "badge bg-danger px-3 py-2 rounded-pill fs-6";
                    badgeEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation me-1"></i>配置比例合計：${totalAllocRatio}% (超出100%)`;
                } else {
                    badgeEl.className = "badge bg-warning text-dark px-3 py-2 rounded-pill fs-6";
                    badgeEl.innerHTML = `<i class="fa-solid fa-circle-info me-1"></i>配置比例合計：${totalAllocRatio}% (尚餘 ${100 - totalAllocRatio}% 未分配)`;
                }
            }

            if (progressText) {
                progressText.innerText = `已配置 ${totalAllocRatio}% / 總本金 NT$ ${Math.round(totalCapital).toLocaleString()}`;
            }
        }

        // 自填總資金輸入處理
        function onAllocTotalCapitalInput(val) {
            const num = parseFloat(val);
            if (!isNaN(num) && num > 0) {
                totalCapital = num;
                document.getElementById('inputTotalCapital').value = totalCapital;
                saveToStorage();
                renderDashboard();
                updateLineShareLink();
            }
        }

        // 自訂欲投資比例變更處理
        function onAllocRatioChange(index, val) {
            const ratio = Math.max(0, parseFloat(val) || 0);
            if (stockList[index]) {
                stockList[index].allocationRatio = ratio;
                saveToStorage();
                renderDashboard();
                updateLineShareLink();
            }
        }

        // 自填持有股數變更處理
        function onAllocHoldingChange(index, val) {
            const shares = Math.max(0, parseFloat(val) || 0);
            if (stockList[index]) {
                stockList[index].currentHoldingShares = shares;
                saveToStorage();
                renderDashboard();
                updateLineShareLink();
            }
        }

        // 自填平均購入價位變更處理
        function onAllocCostChange(index, val) {
            const cost = Math.max(0, parseFloat(val) || 0);
            if (stockList[index]) {
                stockList[index].costPrice = cost;
                saveToStorage();
                renderDashboard();
                updateLineShareLink();
            }
        }

        // 還原預設配置比例 (40/20/20/10/10)
        function resetDefaultAllocations() {
            stockList.forEach(s => {
                if (s.symbol === "2330") s.allocationRatio = 40;
                else if (s.symbol === "SPY") s.allocationRatio = 20;
                else if (s.symbol === "00981A") s.allocationRatio = 20;
                else if (s.symbol === "00982A") s.allocationRatio = 10;
                else if (s.symbol === "00992A") s.allocationRatio = 10;
                else s.allocationRatio = 10;
            });
            totalCapital = 1500000;
            document.getElementById('inputTotalCapital').value = totalCapital;
            if (document.getElementById('inputAllocTotalCapital')) document.getElementById('inputAllocTotalCapital').value = totalCapital;
            saveToStorage();
            renderDashboard();
            updateLineShareLink();
            Swal.fire({
                title: '已還原預設配置！',
                text: '已還原為：總資金 150萬 ｜ 台積電40%、SPY 20%、00981A 20%、00982A 10%、00992A 10%！',
                icon: 'success',
                timer: 2000,
                showConfirmButton: false
            });
        }

        // 開啟新增視窗
        function openAddStockModal() {
            document.getElementById('stockForm').reset();
            document.getElementById('editStockId').value = "";
            document.getElementById('stockModalLabel').innerHTML = '<i class="fa-solid fa-plus me-2"></i>新增追蹤股票、成本與倉位';
            document.getElementById('inputAllocationRatio').value = 20;
            document.getElementById('inputBaseRatio').value = 40;
            document.getElementById('inputRealizedProfit').value = 0;
            stockModalInstance.show();
        }

        // 編輯既有股票
        function editStock(index) {
            const s = stockList[index];
            document.getElementById('editStockId').value = index;
            document.getElementById('stockModalLabel').innerHTML = `<i class="fa-solid fa-pen-to-square me-2"></i>修改 ${s.symbol} ${s.name} 成本與倉位`;

            document.getElementById('inputSymbol').value = s.symbol;
            document.getElementById('inputName').value = s.name;
            document.getElementById('inputMarket').value = s.market;
            document.getElementById('inputAllocationRatio').value = s.allocationRatio !== undefined ? s.allocationRatio : 20;
            document.getElementById('inputCostPrice').value = s.costPrice || s.close;
            document.getElementById('inputRealizedProfit').value = s.realizedProfit || 0;
            document.getElementById('inputClose').value = s.close;
            document.getElementById('inputOpen').value = s.open;
            document.getElementById('inputHigh').value = s.high;
            document.getElementById('inputLow').value = s.low;
            document.getElementById('inputPrevHigh').value = s.prevHigh;
            document.getElementById('inputPrevLow').value = s.prevLow;
            document.getElementById('inputPrevClose').value = s.prevClose || s.close;
            document.getElementById('inputTargetFull').value = s.targetFullShares;
            document.getElementById('inputCurrentHolding').value = s.currentHoldingShares;
            document.getElementById('inputBaseRatio').value = ((s.baseRatio || 0.4) * 100).toFixed(0);

            stockModalInstance.show();
        }

        // 刪除股票
        function deleteStock(index) {
            const s = stockList[index];
            Swal.fire({
                title: `確定要移除 ${s.name} 嗎？`,
                text: "移除後將停止每日慣性訊號追蹤。",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: '確定移除',
                cancelButtonText: '取消'
            }).then((result) => {
                if (result.isConfirmed) {
                    stockList.splice(index, 1);
                    saveToStorage();
                    renderDashboard();
                    updateLineShareLink();
                    Swal.fire('已移除！', `${s.name} 已從清單移除。`, 'success');
                }
            });
        }

        // 表單提交儲存
        document.getElementById('stockForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const editId = document.getElementById('editStockId').value;
            const market = document.getElementById('inputMarket').value;
            const isTW = market === "TW";

            const newStock = {
                id: document.getElementById('inputSymbol').value.trim().toUpperCase(),
                symbol: document.getElementById('inputSymbol').value.trim().toUpperCase(),
                name: document.getElementById('inputName').value.trim(),
                market: market,
                allocationRatio: parseFloat(document.getElementById('inputAllocationRatio').value) || 20,
                unitName: isTW ? "張" : "股",
                sharesPerUnit: isTW ? 1000 : 1,
                costPrice: parseFloat(document.getElementById('inputCostPrice').value) || parseFloat(document.getElementById('inputClose').value) || 0,
                realizedProfit: parseFloat(document.getElementById('inputRealizedProfit').value) || 0,
                targetFullShares: parseFloat(document.getElementById('inputTargetFull').value) || 10000,
                currentHoldingShares: parseFloat(document.getElementById('inputCurrentHolding').value) || 0,
                baseRatio: (parseFloat(document.getElementById('inputBaseRatio').value) || 40) / 100,
                close: parseFloat(document.getElementById('inputClose').value) || 0,
                open: parseFloat(document.getElementById('inputOpen').value) || 0,
                high: parseFloat(document.getElementById('inputHigh').value) || 0,
                low: parseFloat(document.getElementById('inputLow').value) || 0,
                prevHigh: parseFloat(document.getElementById('inputPrevHigh').value) || 0,
                prevLow: parseFloat(document.getElementById('inputPrevLow').value) || 0,
                prevClose: parseFloat(document.getElementById('inputPrevClose').value) || parseFloat(document.getElementById('inputClose').value) || 0,
                date: new Date().toISOString().split('T')[0]
            };

            if (editId !== "") {
                stockList[parseInt(editId)] = newStock;
            } else {
                stockList.push(newStock);
            }

            saveToStorage();
            renderDashboard();
            updateLineShareLink();
            stockModalInstance.hide();

            Swal.fire({
                title: '儲存成功！',
                text: `${newStock.name} 數值與損益已更新並重新試算。`,
                icon: 'success',
                timer: 1500,
                showConfirmButton: false
            });
        });

        // 重設回預設
        function resetToDefault() {
            Swal.fire({
                title: '確定還原為預設設定？',
                text: '將重置為 150 萬自訂資產配置與 5 檔預設投資組合。',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '確定還原',
                cancelButtonText: '取消'
            }).then((res) => {
                if (res.isConfirmed) {
                    totalCapital = 1500000;
                    usdExchangeRate = 32.5;
                    stockList = JSON.parse(JSON.stringify(DEFAULT_STOCKS));
                    saveToStorage();
                    window.location.hash = "";
                    renderDashboard();
                    updateLineShareLink();
                    Swal.fire('已重置！', '已成功還原為 150 萬資產配置預設清單。', 'success');
                }
            });
        }

        // 產生可分享的 URL
        function getShareableUrl() {
            const payload = {
                totalCapital: totalCapital,
                usdRate: usdExchangeRate,
                stocks: stockList
            };
            const jsonStr = JSON.stringify(payload);
            const encoded = btoa(encodeURIComponent(jsonStr));
            const baseUrl = window.location.origin + window.location.pathname;
            return `${baseUrl}#data=${encoded}`;
        }

        function copyShareableUrl() {
            const shareUrl = getShareableUrl();
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(shareUrl).then(() => {
                    Swal.fire({
                        title: '✅ 專屬分享連結已複製！',
                        html: `連結內已包含您目前設定的<strong>總資金預算、所有股票成本、持倉與停泊資金</strong>。<br>直接傳給李老師，老師點開就能看到即時戰報！`,
                        icon: 'success',
                        confirmButtonText: '太棒了'
                    });
                }).catch(() => {
                    prompt('請複製以下專屬分享網址：', shareUrl);
                });
            } else {
                prompt('請複製以下專屬分享網址：', shareUrl);
            }
        }

        function updateLineShareLink() {
            const shareUrl = getShareableUrl();
            const btn = document.getElementById('lineShareTopBtn');
            btn.href = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(shareUrl)}`;
        }

        // 初始化
        window.addEventListener('DOMContentLoaded', () => {
            stockModalInstance = new bootstrap.Modal(document.getElementById('stockModal'));
            loadPortfolioFromStorageOrUrl();
            renderDashboard();
            updateTeachingCard();
            updateLineShareLink();
        });
    </script>
</body>
</html>
