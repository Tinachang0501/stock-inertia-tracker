        // 切換操盤週期 (日K vs 週K)
        function switchTimeframe(tf) {
            currentTimeframe = tf;
            const btnDaily = document.getElementById('tabModeDaily');
            const btnWeekly = document.getElementById('tabModeWeekly');
            const badge = document.getElementById('timeframeBadge');
            const subtext = document.getElementById('timeframeSubtext');

            if (tf === 'weekly') {
                btnDaily.classList.remove('active');
                btnWeekly.classList.add('active');
                badge.innerHTML = '<i class="fa-solid fa-calendar-week me-1"></i>目前檢視：週K長波段';
